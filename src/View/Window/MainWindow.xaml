<local:View x:Class="WinMemoryCleaner.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:WinMemoryCleaner"
            Title="{Binding Title}"
            Width="620" Height="470"
            AllowsTransparency="True"
            Background="Transparent"
            WindowStyle="None"
            ResizeMode="NoResize"
            ShowInTaskbar="True"
            DataContext="{Binding MainViewModel, Source={StaticResource ViewModelLocator}}"
            FlowDirection="{Binding Path=(local:Localizer.Language).Direction}"
            FocusManager.FocusedElement="{Binding ElementName=SmartCleanButton}"
            Foreground="{DynamicResource SecondaryForeground}"
            Icon="/WinMemoryCleaner;component/Resources/Images/win-memory-cleaner.ico"
            UseLayoutRounding="True">
    <Border Background="{DynamicResource PrimaryBackground}" BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1" CornerRadius="8" Margin="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header ============ -->
            <Grid Grid.Row="0" MinHeight="32" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10, 6, 0, 6">
                    <Image Source="/WinMemoryCleaner;component/Resources/Images/win-memory-cleaner.ico" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource SecondaryForeground}" Margin="8, 0, 0, 0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0, 4, 8, 4" VerticalAlignment="Center">
                    <!-- Always on top -->
                    <ToggleButton x:Name="PinButton" ToolTip="{Binding Path=(local:Localizer.String).AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" Width="26" Height="22" Content="&#128204;" FontSize="11" Margin="0, 0, 4, 0" />
                    <!-- Settings -->
                    <Button x:Name="SettingsButton" ToolTip="{Binding Path=(local:Localizer.String).Settings}" Click="OnSettingsButtonClick" Width="26" Height="22" Content="&#9881;" FontSize="12" Margin="0, 0, 4, 0" />
                    <!-- Compact mode -->
                    <ToggleButton x:Name="CompactButton" ToolTip="{Binding Path=(local:Localizer.String).Collapse}" IsChecked="{Binding CompactMode}" Width="26" Height="22" Content="&#9633;" FontSize="11" Margin="0, 0, 4, 0" />
                    <!-- Minimize -->
                    <Button Click="OnMinimizeButtonClick" Width="26" Height="22" Content="&#9472;" FontSize="11" Margin="0, 0, 4, 0" />
                    <!-- Close -->
                    <Button Click="OnCloseButtonClick" Width="26" Height="22" Content="&#10005;" FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- ============ Full content ============ -->
            <Grid x:Name="FullContent" Grid.Row="1" Margin="12, 2, 12, 12" Visibility="{Binding CompactMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2, 4, 2, 8">
                    <Ellipse Width="12" Height="12" Fill="{Binding StatusLevel, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" Margin="0, 0, 8, 0" />
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="16" Foreground="{Binding StatusLevel, Converter={StaticResource StatusToBrushConverter}}" />
                        <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="#AAAAAA" Visibility="{Binding StatusDetail, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Metric cards -->
                <UniformGrid Grid.Row="1" Rows="2" Columns="3" Margin="0, 0, 0, 10">
                    <!-- CPU -->
                    <Border Background="{DynamicResource SecondaryBackground}" BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8, 6">
                        <StackPanel>
                            <TextBlock Text="CPU" FontSize="11" Foreground="#999999" />
                            <TextBlock Text="{Binding CpuText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryForeground}" />
                            <local:SparklineControl x:Name="CpuSparkline" Source="{Binding CpuHistory}" Height="26" Margin="0, 4, 0, 0" />
                        </StackPanel>
                    </Border>
                    <!-- RAM -->
                    <Border Background="{DynamicResource SecondaryBackground}" BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8, 6">
                        <StackPanel>
                            <TextBlock Text="RAM" FontSize="11" Foreground="#999999" />
                            <TextBlock Text="{Binding RamText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryForeground}" />
                            <local:SparklineControl x:Name="RamSparkline" Source="{Binding RamHistory}" Height="26" Margin="0, 4, 0, 0" />
                        </StackPanel>
                    </Border>
                    <!-- GPU -->
                    <Border x:Name="GpuCard" Background="{DynamicResource SecondaryBackground}" BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8, 6">
                        <StackPanel>
                            <TextBlock Text="GPU" FontSize="11" Foreground="#999999" />
                            <TextBlock Text="{Binding GpuText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryForeground}" />
                            <local:SparklineControl x:Name="GpuSparkline" Source="{Binding GpuHistory}" Height="26" Margin="0, 4, 0, 0" />
                        </StackPanel>
                    </Border>
                    <!-- DISK -->
                    <Border Background="{DynamicResource SecondaryBackground}" BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8, 6">
                        <StackPanel>
                            <TextBlock Text="DISK" FontSize="11" Foreground="#999999" />
                            <TextBlock Text="{Binding DiskText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryForeground}" />
                            <local:SparklineControl x:Name="DiskSparkline" Source="{Binding DiskHistory}" Height="26" Margin="0, 4, 0, 0" />
                        </StackPanel>
                    </Border>
                    <!-- VRAM -->
                    <Border Background="{DynamicResource SecondaryBackground}" BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8, 6">
                        <StackPanel>
                            <TextBlock Text="VRAM" FontSize="11" Foreground="#999999" />
                            <TextBlock Text="{Binding VramText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryForeground}" />
                        </StackPanel>
                    </Border>
                    <!-- COMMIT -->
                    <Border Background="{DynamicResource SecondaryBackground}" BorderBrush="{DynamicResource PrimaryBorder}" BorderThickness="1" CornerRadius="4" Margin="2" Padding="8, 6">
                        <StackPanel>
                            <TextBlock Text="COMMIT" FontSize="11" Foreground="#999999" />
                            <TextBlock Text="{Binding CommitText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SecondaryForeground}" />
                            <TextBlock Text="{Binding CommitDetail}" FontSize="11" Foreground="#999999" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Memory detail -->
                <StackPanel Grid.Row="2" Margin="2, 0, 2, 8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RamDetail}" FontSize="13" Foreground="{DynamicResource SecondaryForeground}" />
                        <TextBlock Grid.Column="1" Text="{Binding HardFaultsText}" FontSize="12" Foreground="#999999" />
                    </Grid>
                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding RamUsedPercent, Mode=OneWay}" Background="{DynamicResource SecondaryBackground}" Foreground="{DynamicResource Accent}" BorderThickness="0" Margin="0, 6, 0, 2" />
                    <TextBlock Text="{Binding RamAvailableText}" FontSize="12" Foreground="#AAAAAA" />
                </StackPanel>

                <!-- Top process -->
                <StackPanel Grid.Row="3" Margin="2, 0, 2, 8" Visibility="{Binding TopProcessText, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding Path=(local:Localizer.String).MainLoad}" FontSize="11" Foreground="#999999" />
                    <TextBlock Text="{Binding TopProcessText}" FontSize="14" Foreground="{DynamicResource SecondaryForeground}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Row="4" />

                <!-- Buttons -->
                <Grid Grid.Row="5" Margin="2, 0, 2, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="SmartCleanButton" Command="{Binding SmartCleanupCommand}" Height="40" FontSize="14" Margin="0, 0, 4, 0"
                            Content="{Binding SmartCleanupButtonText}" />
                    <StackPanel Grid.Column="1" Margin="4, 0, 0, 0">
                        <ToggleButton Command="{Binding TogglePerformanceModeCommand}" IsChecked="{Binding IsPerformanceModeOn, Mode=OneWay}" Height="40" FontSize="14" Content="{Binding Path=(local:Localizer.String).PerformanceMode}" />
                        <TextBlock Text="{Binding PerformanceModeText}" FontSize="11" Foreground="#E0B23A" Visibility="{Binding PerformanceModeText, Converter={StaticResource NullToVisibilityConverter}}" Margin="2, 2, 0, 0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ Compact content ============ -->
            <Grid x:Name="CompactContent" Grid.Row="1" Margin="10, 0, 10, 10" Visibility="{Binding CompactMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2, 0, 2, 6">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusLevel, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" Margin="0, 0, 6, 0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="{Binding StatusLevel, Converter={StaticResource StatusToBrushConverter}}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Metrics one-liner -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2, 0, 2, 4">
                    <TextBlock Text="CPU " FontSize="13" Foreground="#999999" />
                    <TextBlock Text="{Binding CpuText}" FontSize="13" Foreground="{DynamicResource SecondaryForeground}" Margin="0, 0, 10, 0" />
                    <TextBlock Text="RAM " FontSize="13" Foreground="#999999" />
                    <TextBlock Text="{Binding RamText}" FontSize="13" Foreground="{DynamicResource SecondaryForeground}" Margin="0, 0, 10, 0" />
                    <TextBlock Text="GPU " FontSize="13" Foreground="#999999" />
                    <TextBlock Text="{Binding GpuText}" FontSize="13" Foreground="{DynamicResource SecondaryForeground}" Margin="0, 0, 10, 0" />
                    <TextBlock Text="D " FontSize="13" Foreground="#999999" />
                    <TextBlock Text="{Binding DiskText}" FontSize="13" Foreground="{DynamicResource SecondaryForeground}" />
                </StackPanel>

                <!-- RAM available + top process -->
                <StackPanel Grid.Row="2" Margin="2, 0, 2, 0">
                    <TextBlock Text="{Binding RamAvailableText}" FontSize="12" Foreground="#AAAAAA" />
                    <TextBlock Text="{Binding TopProcessText}" FontSize="12" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Row="3" />

                <!-- Buttons -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="SmartCleanButtonCompact" Command="{Binding SmartCleanupCommand}" Height="30" FontSize="12" Margin="0, 0, 4, 0"
                            Content="{Binding SmartCleanupButtonText}" />
                    <ToggleButton Grid.Column="1" Command="{Binding TogglePerformanceModeCommand}" IsChecked="{Binding IsPerformanceModeOn, Mode=OneWay}" Height="30" Width="36" FontSize="13" Content="&#9889;" ToolTip="{Binding Path=(local:Localizer.String).PerformanceMode}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</local:View>
